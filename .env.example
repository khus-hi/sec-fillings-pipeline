# Copy this file to .env and fill in your values. .env is gitignored: never commit it.

# --- SEC EDGAR -------------------------------------------------------------
# Required by SEC: your name and a contact email. Requests without it get blocked.
SEC_USER_AGENT="Your Name your.email@example.com"
# SEC allows 10 requests/second. We default to 5 to be a polite citizen.
# SEC_MAX_RPS=5
# How many recent 10-Ks to pull per company (3 gives a year-over-year view).
# FILINGS_PER_COMPANY=3

# --- Raw zone (MinIO locally, same code works against AWS S3) -------------
STORAGE_BACKEND=s3
S3_BUCKET=sec-raw
S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
# MinIO's root user/password from docker-compose.yml. Local-only dev credentials.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# To skip MinIO entirely and write to ./data/raw/edgar instead:
# STORAGE_BACKEND=local

# --- Warehouse --------------------------------------------------------------
# DATA_DIR=data
# DUCKDB_PATH=data/warehouse.duckdb
